#pragma code_page(65001) // Source is UTF-8 (PUB_RELEASE_NAME_STRING)

#include <Windows.h>

#include "core/CMakeMacroGuard.h"
#include "core/Publication.h"
#include "core/Version.h"

// NB: Built as part of the target, so this receives the target's compile
// definitions (APP_DEBUG) and include directories. The fallback include only
// matters outside CMake (e.g. VS resource view)

// clang-format off

// Icon
IDI_ICON1           ICON "icons/Fernanda.ico"

// Flags (test values, never `defined()`: both macros are always defined)
#if APP_DEBUG
#    define RC_FLAG_DEBUG_          VS_FF_DEBUG
#else
#    define RC_FLAG_DEBUG_          0
#endif

#if VERSION_IS_PRERELEASE
#    define RC_FLAG_PRERELEASE_     VS_FF_PRERELEASE
#else
#    define RC_FLAG_PRERELEASE_     0
#endif

// Version info
VS_VERSION_INFO     VERSIONINFO
FILEVERSION         VERSION_3
PRODUCTVERSION      VERSION_2
FILEFLAGSMASK       VS_FFI_FILEFLAGSMASK
FILEFLAGS           RC_FLAG_DEBUG_ | RC_FLAG_PRERELEASE_
FILEOS              VOS_NT_WINDOWS32
FILETYPE            VFT_APP
FILESUBTYPE         VFT2_UNKNOWN

BEGIN
    BLOCK           "StringFileInfo"
    BEGIN
        BLOCK       "040904B0" // English (US), Unicode
        BEGIN
            VALUE   "CompanyName",      PUB_AUTHOR_STRING
            VALUE   "FileDescription",  PUB_APP_NAME_STRING
            VALUE   "FileVersion",      VERSION_FULL_STRING
            VALUE   "InternalName",     PUB_RELEASE_NAME_STRING
            VALUE   "LegalCopyright",   PUB_COPYRIGHT_STRING
            VALUE   "OriginalFilename", PUB_APP_NAME_STRING ".exe" // Q_OS_WIN isn't visible here
            VALUE   "ProductName",      PUB_APP_NAME_STRING
            VALUE   "ProductVersion",   VERSION_FULL_STRING // What Explorer shows as text
        END
    END
    BLOCK           "VarFileInfo"
    BEGIN
        VALUE       "Translation", 0x409, 1200 // English (US), Unicode
    END
END

    // clang-format on
